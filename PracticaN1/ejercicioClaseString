#include<stdio.h>
#include <string.h>

int main(){

    char name[10];
    printf("Ingrese un nombre: ");
    scanf("%s", name);
    printf("\nIngrese un apellido: ");
    char apellido[20];
    scanf("%s", apellido);
    char completo[30];
    char espacio[10] = " ";

    strcpy(completo,strcat(name, strcat(espacio, apellido)));
    printf("El nombre que ingreso es: %s", completo);
    return 0;

}
